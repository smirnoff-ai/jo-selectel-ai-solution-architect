# Скопировать в .env:  cp .env.example .env
# Или: make env  (подставит OPENAI_API_KEY из Keychain: OPENROUTER_API_KEY)
#
# OPENAI_API_KEY — единственный настоящий секрет. В git не кладём.
# Тестовый ключ на 1 USD — в сопроводительном письме рекрутеру.
# Остальное ниже — локальные заглушки демо, не прод-секреты.

OPENAI_API_KEY=
# Settings его требует, ChatOpenRouter не читает (пакет сам ходит на OpenRouter).
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=qwen/qwen3.6-35b-a3b

# Локальный Langfuse в compose (headless init). Контейнер для разбора не обязателен,
# без этих трёх строк backend не стартует. Для трасс: http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_HOST=http://langfuse:3000

DATABASE_URL=postgresql+asyncpg://reflex:reflex@postgres:5432/reflex
SESSION_SECRET=local-reflex-session
DISPATCHER_LOGIN=dispatcher
DISPATCHER_PASSWORD=secret

MOCK_SEVERHOLOD_URL=http://mock-severholod:8080
